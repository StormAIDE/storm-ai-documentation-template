\renewcommand{\cftsubsecfont}{\color{StormTeal}}
\renewcommand{\cftsubsecpagefont}{\color{StormTeal}}
\renewcommand{\cftsubsubsecfont}{\color{StormDark}}
\renewcommand{\cftsubsubsecpagefont}{\color{StormDark}}
\renewcommand{\cfttoctitlefont}{\stormdisplay\fontsize{12}{14}\selectfont\color{StormTeal}}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{%
$if(title)$
  \begin{minipage}[b]{0.78\textwidth}
    {\bfseries\fontsize{8.5}{10}\selectfont\color{StormGrey}$title$}$if(subtitle)$\\[-1pt]
    {\fontsize{7.5}{9}\selectfont\color{StormTeal}$subtitle$}$endif$
  \end{minipage}%
$endif$}
\fancyhead[R]{\fontsize{7.5}{9}\selectfont\color{StormGrey}$revision$}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{%
  \begin{minipage}{\textwidth}
    \colorbox{StormLight}{%
      \parbox{\dimexpr\textwidth-2\fboxsep\relax}{%
        \fontsize{6.5}{8}\selectfont\color{StormDark}
        \lblCreatedBy: $author$
        \hfill \lblApprovedBy: $approved_by$
        \hfill \lblRevision: $revision$
        \hfill \lblPage: \thepage/\pageref{LastPagePlaceholder}}}%
    $if(document_id)$\\[-1pt]\hfill{\fontsize{6}{7}\selectfont\color{StormGrey}$document_id$}$endif$
  \end{minipage}}
\renewcommand{\footrulewidth}{0pt}

