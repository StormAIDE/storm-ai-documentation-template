}

\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}
\setlength{\emergencystretch}{3em}
\renewcommand{\arraystretch}{1.35}
\arrayrulecolor{white}
\renewcommand{\toprule}{\rowcolor{StormTeal}}
\AtBeginEnvironment{longtable}{\rowcolors{2}{StormLight}{white}}
\AtBeginEnvironment{tabular}{\rowcolors{2}{StormLight}{white}}

\makeatletter
\renewcommand\section{\@startsection{section}{1}{0pt}{18pt}{7pt}{\stormdisplay\fontsize{12}{14}\selectfont\color{StormTeal}}}
\renewcommand\subsection{\@startsection{subsection}{2}{0pt}{14pt}{5pt}{\bfseries\fontsize{11}{13}\selectfont\color{StormTeal}}}
\renewcommand\subsubsection{\@startsection{subsubsection}{3}{0pt}{12pt}{4pt}{\bfseries\fontsize{10}{12}\selectfont\color{StormDark}}}
\makeatother

\renewcommand{\contentsname}{\lblContents}
\newcounter{none}
\setcounter{tocdepth}{3}
\setcounter{secnumdepth}{3}

\renewcommand{\cftsecfont}{\color{StormTeal}\bfseries}
